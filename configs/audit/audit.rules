#watch sudo execution, sudoers file
-w /usr/bin/sudo -p x -k sudo-execution
-a always,exit -F arch=b64 -S execve -F euid=0 -k privileged-exec
-w /etc/sudoers -p rwa -k sudoers-modified
-w /etc/sudoers.d/ -p rwa -k sudoers-modified
#watch authentication file
-w /var/log/auth.log -p rwa -k authentications-log
#watch groups
-w /etc/group -p rwa -k groups-modified
#watch users database
-w /etc/passwd -p rwa -k users-access
#watch passwords
-w /etc/shadow -p rwa -k password-access
#watch users creation,deletion,modification
-w /etc/useradd -p x -k add-user
-w /etc/userdel -p x -k delete-user
-w /etc/usermod -p x -k modify-user
#watch ssh confih=guration
-w /etc/ssh/sshd_config -p rwa -k ssh-configuration
-w /etc/ssh/sshd_config.d -p rwa -k ssh-configuration
-w /etc/ssh/ -p rwa -k ssh-configuration
#watch auditd
-w /etc/audit -p rwa -k audit-config 
-w /var/log/audit -p rwa -k audit-logs 
#watch firewalls
-w /etc/nftables.conf -p rwa -k firewall-modified
#watch root directory
-w /root/ -p rwa -k root-directory
#watch .ssh
-w /home/developer1/.ssh/ -p rwa -k ssh-directories
-w /home/ops1/.ssh/ -p rwa -k ssh-directories
-w /home/auditor/.ssh/ -p rwa -k ssh-directories

#Watch all authorized_keys files
-w /home/developer1/.ssh/authorized_keys -p rwa -k authorized-keys
-w /home/ops1/.ssh/authorized_keys -p rwa -k authorized-keys
-w /home/auditor/.ssh/authorized_keys -p rwa -k authorized-keys
-w /root/.ssh/ -p rwa -k authorized-keys

# Watch permission and ownership changes on sensitive paths
-a always,exit -F arch=b64 -S chmod -S fchmod -S chown -S fchown -F auid>=1000 -k permission-change
-a always,exit -F arch=b32 -S chmod -S fchmod -S chown -S fchown -F auid>=1000 -k permission-change
#watch fail2ban
-w /etc/fail2ban/ -p rwa -k fail2ban-config
