Host bastion-dev
    HostName 127.0.0.1
    Port 2000
    User developer1
    IdentityFile C:\Users\user\.ssh\dev1_key
    IdentitiesOnly yes
    ForwardAgent yes

Host kali-dev
    HostName 192.168.10.10
    User developer1
    ProxyJump bastion-dev
    ForwardAgent yes
